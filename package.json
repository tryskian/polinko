{
  "name": "polinko-dev-tools",
  "private": true,
  "version": "0.1.0",
  "description": "Static site and repo-root tooling for Polinko, a human-led AI evaluation research system",
  "scripts": {
    "lint:docs": "markdownlint README.md apps/**/*.md docs/**/*.md docs/public/diagrams/*.md docs/eval/beta_*/README.md site/*.md",
    "typecheck:pyright": "pyright --project pyrightconfig.json",
    "build": "node tools/build_static_site.mjs",
    "site:check": "node tools/check_site_contract.mjs",
    "check:site": "npm run site:check"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.2.0",
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "jsdom": "31.0.1",
    "markdownlint-cli": "0.50.0",
    "pyright": "1.1.414"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "markdown-it": "14.3.3",
    "postcss-selector-parser": "6.1.4",
    "smol-toml": "1.9.1",
    "ws": "8.21.0",
    "js-yaml": "5.4.1",
    "katex": "0.18.2",
    "source-map-js": "1.2.2",
    "undici": "8.12.4",
    "zod": "4.6.7",
    "minimatch@>=7": "11.0.1"
  }
}
