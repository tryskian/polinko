{
  "name": "polinko-dev-tools",
  "private": true,
  "version": "0.1.0",
  "description": "Static site and repo-root tooling for Polinko, a human-led AI evaluation research system",
  "scripts": {
    "lint:docs": "markdownlint-cli2 README.md apps/**/*.md docs/**/*.md docs/public/diagrams/*.md docs/eval/beta_*/README.md site/*.md",
    "typecheck:pyright": "pyright --project pyrightconfig.json",
    "build": "node tools/build_static_site.mjs",
    "site:check": "node tools/check_site_contract.mjs",
    "check:site": "npm run site:check"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.17.0",
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "jsdom": "30.0.1",
    "markdownlint-cli2": "0.23.2",
    "pyright": "1.1.414"
  },
  "overrides": {
    "dompurify": "3.4.14",
    "markdown-it": "14.3.0",
    "postcss-selector-parser": "6.1.4",
    "smol-toml": "1.8.0",
    "ws": "8.21.0"
  }
}
